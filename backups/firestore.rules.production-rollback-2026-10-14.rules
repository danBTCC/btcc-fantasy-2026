rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /submissions/{eventId}/entries/{uid} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid);

      allow write: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid);
    }

    match /players/{uid} {
      allow read: if true;

      allow write: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid);
    }

    match /news/{newsId}/reactions/{userId} {
      allow read: if true;

      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && exists(/databases/$(database)/documents/news/$(newsId))
        && exists(/databases/$(database)/documents/players/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['type', 'updatedAt'])
        && request.resource.data.type in ['like', 'love', 'funny', 'wow']
        && request.resource.data.updatedAt == request.time;

      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
